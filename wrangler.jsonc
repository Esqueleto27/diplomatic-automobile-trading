{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "diplomatic-automobile-trading",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "diplomatic-automobile-trading"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS_BUCKET",
			"bucket_name": "diplomatic-automobile-trading-photos"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "diplomatic-automobile-trading-db",
			"database_id": "2dbd3843-5030-426b-9c46-607ced93553a"
		}
	],
	"ratelimits": [
		{
			// Login del admin: hay un único usuario y su email es adivinable —
			// sin esto, nada impedía lanzarle miles de intentos de contraseña
			// por segundo a loginAction. `namespace_id` es sólo un identificador
			// arbitrario que separa el estado de este limiter del de contacto,
			// no hace falta crearlo con ningún comando aparte.
			"name": "RATE_LIMITER_LOGIN",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			// Formulario de contacto: público y sin sesión, escribe directo en
			// D1. El honeypot (ver enviarMensajeContacto) frena bots torpes,
			// no uno que hable el protocolo de Server Actions.
			"name": "RATE_LIMITER_CONTACTO",
			"namespace_id": "1002",
			"simple": { "limit": 3, "period": 60 }
		}
	],
	"vars": {
		// URL pública desde donde se sirven las fotos de PHOTOS_BUCKET. Hoy es
		// el *.r2.dev gratuito de Cloudflare (activado con
		// `wrangler r2 bucket dev-url enable`) — cuando el cliente tenga
		// dominio propio en Cloudflare, conectar un dominio custom al bucket
		// y reemplazar este valor, sin tocar código. No es secreto, por eso
		// va acá y no con `wrangler secret put`.
		"R2_PUBLIC_URL": "https://pub-2a4b20ea6c834e9d8fda32f7a54be906.r2.dev",
		// Número de WhatsApp para el botón "Agendar Test Drive" / "Consultar".
		// No es secreto (es el mismo teléfono público del sitio), por eso va
		// acá igual que R2_PUBLIC_URL en vez de con `wrangler secret put`.
		"WHATSAPP_NUMBER": "+593999808067",
		// Segunda línea del negocio: atiende los tres seguros (vehículos,
		// viajes y salud). El resto de los servicios sigue yendo a
		// WHATSAPP_NUMBER — ver la marca `lineaSeguros` en src/lib/site.ts.
		"WHATSAPP_NUMBER_SEGUROS": "+593984312146"
		// AUTH_SECRET NO va acá: si un `var` con ese nombre existe en este
		// archivo, `wrangler deploy` lo usa y BORRA el secret real puesto con
		// `wrangler secret put` (es al revés de lo que parece — el var pisa al
		// secret al deployar, no al revés). El secret real vive sólo en
		// Cloudflare (`wrangler secret put AUTH_SECRET`) y en `.dev.vars` para
		// local. El tipo se declara a mano en cloudflare-env.d.ts.
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}