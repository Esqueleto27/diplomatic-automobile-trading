# Copiar a .env y completar.
#
# Sólo para scripts de Node plano (scripts/seed-admin.ts, scripts/seed-demo.ts)
# que corren fuera de Workers. Todo lo que la app usa en runtime (AUTH_SECRET,
# R2_PUBLIC_URL, bindings D1/R2) vive en .dev.vars (local) y wrangler.jsonc +
# `wrangler secret put` (producción), no acá.

# --- Admin único (usado por scripts/seed-admin.ts) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- WhatsApp (botón "Agendar Test Drive") ---
WHATSAPP_NUMBER=""
