# Copiar a .env y completar.
#
# LOCAL (npm run dev): solo necesitas DATABASE_URL (docker-compose.dev.yml),
# AUTH_SECRET, ADMIN_EMAIL/ADMIN_PASSWORD.
#
# PRODUCCIÓN (docker-compose.yml en el VPS): además necesitas
# POSTGRES_USER/PASSWORD/DB y APP_PORT — docker-compose arma el
# DATABASE_URL solo, no lo definas a mano ahí.

# --- Base de datos (local) ---
DATABASE_URL="postgresql://user:password@localhost:5432/diplomatic_dev?schema=public"

# --- Base de datos (solo producción, usado por docker-compose.yml) ---
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# --- Puerto local del contenedor de la app (solo producción) ---
# Distinto por proyecto en el VPS. Nginx del host hace proxy_pass a
# 127.0.0.1:APP_PORT.
APP_PORT="3010"

# --- Auth.js ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Admin único (usado por prisma/seed.ts para crear/actualizar el usuario admin) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Cloudflare R2 (fotos de autos) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# --- WhatsApp (botón "Agendar Test Drive") ---
WHATSAPP_NUMBER=""
